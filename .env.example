# скопируйте в .env; секреты в репозиторий не коммитим
POSTGRES_USER=autochoice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autochoice
DATABASE_URL=postgresql+psycopg://autochoice:change-me@db:5432/autochoice
MEDIA_BASE_URL=/static/media

# Хранилище 3D-моделей: local (папка static/media) или s3 (MinIO / AWS S3 / Yandex Object Storage)
STORAGE_BACKEND=s3
S3_ENDPOINT=http://s3:9000
S3_BUCKET=autochoice-models
S3_ACCESS_KEY=autochoice
S3_SECRET_KEY=change-me-too
S3_REGION=us-east-1
# Токен Sketchfab (личный кабинет -> Settings -> Password & API): включает официальное скачивание моделей
SKETCHFAB_TOKEN=
